NODE_ENV=development
PORT=5000

# Neon Database
# Get this from: https://console.neon.tech -> Your Project -> Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Initial Manager Account (for first-time setup)
INITIAL_MANAGER_EMAIL=admin@securify.local
INITIAL_MANAGER_PASSWORD=ChangeMe123456
INITIAL_MANAGER_NAME=System Administrator
